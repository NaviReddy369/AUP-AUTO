{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/connect", "destination": "/api" },
    { "source": "/callback", "destination": "/api" },
    { "source": "/disconnect", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/sync", "schedule": "0 6 * * *" }
  ]
}
